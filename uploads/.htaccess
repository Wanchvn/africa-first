# Prevent PHP execution inside uploads/
php_flag engine off

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^private_posts/ - [F,L,NC]
</IfModule>

# Block dangerous extensions
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|pl|py|jsp|asp|aspx|sh|cgi|htaccess|enc)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block video (mp4, mov, mkv) — but NOT webm (we need it for voice)
<FilesMatch "\.(mp4|mov|mkv)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Whitelist images + audio
<FilesMatch "\.(jpg|jpeg|png|gif|webp|webm|ogg|m4a|mp3|wav|aac)$">
    Order allow,deny
    Allow from all
</FilesMatch>

# Correct MIME types so browsers can play
AddType audio/webm .webm
AddType audio/ogg  .ogg
AddType audio/mp4  .m4a
AddType audio/mpeg .mp3
AddType audio/wav  .wav
AddType audio/aac  .aac


# Post voice notes must be served through voice_serve.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^voice/ - [F,L,NC]
</IfModule>