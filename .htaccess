# ============================================================
# QAROTA — Project Root .htaccess
# ============================================================

# ---- Security Headers ----
<IfModule mod_headers.c>

    # Clickjacking protection
    Header set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME sniffing — always trust Content-Type
    Header set X-Content-Type-Options "nosniff"

    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Feature policy — allow mic for self (voice messages), deny the rest
    Header set Permissions-Policy "geolocation=(), microphone=(self), camera=(), payment=()"

    # Content Security Policy
    # - 'unsafe-inline' for style is needed (inline style="..."" attributes)
    # - 'unsafe-inline' for script is needed (inline JS in header.php)
    # - media-src 'self' allows the <audio> and <video> elements to load local files
    # - img-src 'self' data: allows local images and data: URIs
    Header set Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'self'; form-action 'self'"

    # Don't advertise PHP version
    Header unset X-Powered-By

</IfModule>

# ============================================================
# BLOCK SENSITIVE FOLDERS
# ============================================================
# These folders must never be directly accessible from the browser.

# config/ — contains DB credentials
RedirectMatch 404 (?i)^.*/config/.*$

# includes/ — contains PHP helpers
RedirectMatch 404 (?i)^.*/includes/.*$

# lang/ — contains translation files
RedirectMatch 404 (?i)^.*/lang/.*$

# sql/ — if you ever add a schema folder
RedirectMatch 404 (?i)^.*/sql/.*$

# ============================================================
# ALLOW PUBLIC UPLOADS
# ============================================================
# Uploads are user files. They must be servable.
# We explicitly allow them AFTER the block rules so they win.
<FilesMatch "\.(jpg|jpeg|png|gif|webp|webm|ogg|m4a|mp3|wav|svg)$">
    Require all granted
</FilesMatch>

# ============================================================
# BLOCK HIDDEN FILES
# ============================================================
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ============================================================
# BLOCK SENSITIVE EXTENSIONS
# ============================================================
<FilesMatch "\.(env|log|sql|bak|lock|ini|conf)$">
    Require all denied
</FilesMatch>

# ============================================================
# PREVENT DIRECTORY LISTING
# ============================================================
Options -Indexes

# ============================================================
# BLOCK EXECUTION IN UPLOADS
# ============================================================
# Belt-and-braces: even if a .php file lands in /uploads/, don't run it.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^uploads/.*\.(php|phtml|php3|php4|php5|php7|phps|pl|py|jsp|asp|aspx|sh|cgi)$ - [F,L]
</IfModule>