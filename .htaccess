# ============================================================
# QAROTA — Project Root .htaccess
# ============================================================

# ---- Force HTTPS (uncomment on production) ----
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} off
#     RewriteCond %{HTTP:X-Forwarded-Proto} !https
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# ---- Security Headers ----
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(self), camera=(), payment=()"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'self'; form-action 'self'"
    Header always unset X-Powered-By
</IfModule>

# ============================================================
# BLOCK SENSITIVE FOLDERS
# ============================================================
RedirectMatch 404 (?i)^.*/config/.*$
RedirectMatch 404 (?i)^.*/includes/.*$
RedirectMatch 404 (?i)^.*/lang/.*$
RedirectMatch 404 (?i)^.*/sql/.*$
RedirectMatch 404 (?i)^.*/storage/verifications/.*$

# ============================================================
# BLOCK DEV / VCS FOLDERS
# ============================================================
RedirectMatch 404 (?i)^.*/\.git(/.*)?$
RedirectMatch 404 (?i)^.*/\.gitignore$
RedirectMatch 404 (?i)^.*/\.gitattributes$
RedirectMatch 404 (?i)^.*/\.htaccess$
RedirectMatch 404 (?i)^.*/\.htpasswd$
RedirectMatch 404 (?i)^.*/composer\.(json|lock)$
RedirectMatch 404 (?i)^.*/package(-lock)?\.json$
RedirectMatch 404 (?i)^.*/node_modules(/.*)?$
RedirectMatch 404 (?i)^.*/vendor(/.*)?$
RedirectMatch 404 (?i)^.*/\.vscode(/.*)?$
RedirectMatch 404 (?i)^.*/\.idea(/.*)?$
RedirectMatch 404 (?i)^.*/\.DS_Store$

# ============================================================
# ALLOW PUBLIC UPLOADS
# ============================================================
<FilesMatch "\.(jpg|jpeg|png|gif|webp|webm|ogg|m4a|mp3|wav|svg|mp4|mov)$">
    Require all granted
</FilesMatch>

# ============================================================
# BLOCK HIDDEN FILES
# ============================================================
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ============================================================
# BLOCK SENSITIVE EXTENSIONS
# ============================================================
<FilesMatch "\.(env|log|sql|bak|lock|ini|conf)$">
    Require all denied
</FilesMatch>

# ============================================================
# PREVENT DIRECTORY LISTING
# ============================================================
Options -Indexes

# ============================================================
# BLOCK EXECUTION IN UPLOADS
# ============================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^uploads/.*\.(php|phtml|php3|php4|php5|php7|phps|pl|py|jsp|asp|aspx|sh|cgi)$ - [F,L]
</IfModule>

# ============================================================
# PWA FILES
# ============================================================
<Files "manifest.json">
    Require all granted
    Header set Content-Type "application/manifest+json"
</Files>
<Files "sw.js">
    Require all granted
    Header set Service-Worker-Allowed "/qarota/"
</Files>