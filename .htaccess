# ---- Security Headers ----
<IfModule mod_headers.c>
    # Prevent the page from being embedded in iframes (clickjacking protection)
    Header set X-Frame-Options "SAMEORIGIN"

    # Prevent browsers from MIME-sniffing — always use declared Content-Type
    Header set X-Content-Type-Options "nosniff"

    # Limit referrer info sent to other sites
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Disable browser features we don't use (geolocation, mic, camera, etc.)
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

    # Basic CSP — allows only what Qarota needs
    # NOTE: 'unsafe-inline' for style is needed because we use inline styles like <div style="...">
    # NOTE: 'unsafe-inline' for script is needed because we have inline <script> for the hamburger menu
    Header set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-ancestors 'self'; form-action 'self'"

    # Remove the X-Powered-By header (don't advertise PHP version)
    Header unset X-Powered-By
</IfModule>

# ---- Block Direct Access to Sensitive Folders ----
# Users must never load config/, includes/, or lang/ directly.
# These folders are only meant to be accessed via PHP includes.

# Block config/ folder
RedirectMatch 404 ^/qarota/config/

# Block includes/ folder
RedirectMatch 404 ^/qarota/includes/

# Block lang/ folder
RedirectMatch 404 ^/qarota/lang/

# If Qarota lives at the root of a domain (e.g. qarota.com/config/),
# use these instead — uncomment at deploy time:
# RedirectMatch 404 ^/config/
# RedirectMatch 404 ^/includes/
# RedirectMatch 404 ^/lang/

# ---- Block Hidden Files ----
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ---- Prevent Directory Listing ----
Options -Indexes

# ---- Block Access to Sensitive File Extensions ----
<FilesMatch "\.(env|log|sql|bak|md|json|lock)$">
    Require all denied
</FilesMatch>